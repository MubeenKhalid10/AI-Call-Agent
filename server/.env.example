# Ai-Voice-Agent — environment variables
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys.
#
# Everything below the required keys is optional and has a working default, so a
# .env with three keys in it is a complete configuration. The knobs exist so that
# tuning the agent is an edit here rather than a code change.


# ---- Required keys ---------------------------------------------------------

# Deepgram — speech-to-text and end-of-turn detection.
# https://console.deepgram.com  ($200 free credit)
DEEPGRAM_API_KEY=

# Cartesia — text-to-speech.  https://play.cartesia.ai/keys  (free tier)
CARTESIA_API_KEY=

# Groq — the LLM. Free, no card required.  https://console.groq.com/keys
# Groq is the default because it has the fastest time-to-first-token of any
# hosted provider, and in a live conversation that dominates everything else.
GROQ_API_KEY=

# Google Gemini — use with LLM_PROVIDER=gemini.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=


# ---- Optional: swap providers ----------------------------------------------
# Each stage is built by a factory in src/services.py. Changing these values is
# all that is needed to switch; bot.py does not change.
#
#   STT_PROVIDER   deepgram_flux | deepgram             (default: deepgram_flux)
#   TTS_PROVIDER   cartesia | deepgram | elevenlabs     (default: cartesia)
#   LLM_PROVIDER   groq | gemini | anthropic | openai | cerebras |
#                  openrouter | mistral | ollama        (default: groq)
#
# All LLM providers above work with the packages already installed.
# Switching TTS to deepgram reuses DEEPGRAM_API_KEY and needs no new key.

# LLM_PROVIDER=groq
# TTS_PROVIDER=cartesia

# ElevenLabs TTS. Required when TTS_PROVIDER=elevenlabs (or when it is the fallback).
# ELEVENLABS_API_KEY=       # https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_VOICE_ID=      # copy from the ElevenLabs voice library
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Optional: TTS fallback -------------------------------------------------
# A second TTS provider on standby for every call. If the primary fails before
# it has produced audio for what it was asked to say — HTTP 402 (credits
# exhausted), a connection or timeout failure, a provider error — the rest of
# the call is spoken by the fallback: once per call, never back. The sentence
# that failed is spoken once, by the fallback, only if the primary produced no
# audio for it; nothing is spoken twice. Needs the fallback's own key (and
# ELEVENLABS_VOICE_ID when it is elevenlabs). `health.py tts_fallback` checks
# the key without synthesising anything. Leave it off when TTS_PROVIDER is
# already the provider you want as the only one.
# TTS_FALLBACK_ENABLED=false
# TTS_FALLBACK_PROVIDER=elevenlabs   # cartesia | deepgram | elevenlabs; not the same as TTS_PROVIDER

# STT_PROVIDER decides how turn-taking works, not just who transcribes:
#
#   deepgram_flux  Deepgram's conversational model. Transcription and end-of-turn
#                  detection come back on the same websocket, judged from the
#                  words and the prosody rather than from silence. It does not
#                  cut in on a mid-sentence pause and does not sit waiting after
#                  a finished question.
#   deepgram       Classic streaming transcription. Turn detection falls back to
#                  local Silero VAD plus the Smart Turn v3 model. Use this if
#                  your Deepgram account has no Flux access, or as the A/B
#                  baseline when measuring what Flux is worth.
#
# STT_PROVIDER=deepgram_flux


# ---- Optional: other LLM providers -----------------------------------------
# Set LLM_PROVIDER to one of these and supply the matching key.
# Free tiers: groq, gemini, cerebras, mistral, openrouter (some models), ollama (local).
# Paid credits required: anthropic, openai.

# CEREBRAS_API_KEY=          # https://cloud.cerebras.ai
# MISTRAL_API_KEY=           # https://console.mistral.ai/api-keys
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys
# ANTHROPIC_API_KEY=         # https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=            # https://platform.openai.com/api-keys
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
#
# ollama needs no key at all — install from https://ollama.com, run
# `ollama pull llama3.2`, then set LLM_PROVIDER=ollama. Fully local and free
# forever, but latency depends entirely on your hardware.


# ---- Optional: model and voice ---------------------------------------------
# Each LLM provider reads <PROVIDER>_MODEL; STT reads STT_MODEL. Defaults are in
# src/config.py. If a default model ID stops working, the provider retired it —
# set it here.

# GROQ_MODEL=qwen/qwen3.8-27b
#   Measured 2026-09-01 on Groq: 324 ms to first token, the fastest available.
#
#   The openai/gpt-oss-* models are reasoning models. They return EMPTY content
#   unless you also pass reasoning_effort="low", so only use them if you set
#   that (via Settings(extra=...) in src/services.py). Measured with it:
#     openai/gpt-oss-20b   409 ms
#     openai/gpt-oss-120b  590 ms   (better reasoning, useful for tool calling)
#   groq/compound-mini is 1139 ms — too slow for a live conversation.
#
#   Groq rotates its catalogue often. A 404 "model_not_found" mid-call means the
#   model was retired: pick a current ID and set it here.
#   Your account's list: https://console.groq.com/docs/models

# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=llama3.2

# The most tokens the LLM may generate in one turn. A spoken reply is one to
# three sentences and a tool call is a few dozen tokens, so this is generous.
#
# It is sent on every request, and that matters more than it looks: Groq's free
# tier enforces an output-tokens-per-minute limit against each request's
# *expected* output, which it estimates generously when no cap is given.
# Observed 2026-09-04, with the Phase 7 tools advertised: every request refused
# as "too large" (estimated 1815 against a limit of 1000) before the model said
# a word. If you see "Request too large ... output tokens per minute" in the
# log, lower this; if replies or tool calls are being cut off, raise it.
# Default: 400
# LLM_MAX_OUTPUT_TOKENS=400

# Phase 26. On Groq, a reasoning model (qwen3, gpt-oss, deepseek-r1) with
# tools advertised streams its thinking into the answer by default, and the
# voice speaks it. `hidden` asks Groq for the final answer only; `parsed`
# keeps the reasoning in a field the bot ignores; `off` sends nothing (use it
# if the provider rejects the parameter). The pipeline also drops tagged
# reasoning and unspeakable text before the TTS whatever this is set to.
# Default: hidden
# LLM_REASONING_FORMAT=hidden

# STT_MODEL defaults to flux-general-en for deepgram_flux and nova-3 for
# deepgram. Use flux-general-multi for multilingual Flux.
# STT_MODEL=flux-general-en

# Cartesia voice. Browse voices at https://play.cartesia.ai
# CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49


# ---- Optional: turn taking (STT_PROVIDER=deepgram_flux) --------------------
# Unset means "use Deepgram's own default", which is tuned. Change one at a time
# and re-run the evals; these trade responsiveness against interrupting people.

# FLUX_EOT_THRESHOLD=0.7
#   Confidence required before Flux calls the turn finished. Lower ends turns
#   sooner (snappier, but more likely to cut someone off mid-thought); higher
#   waits for more certainty (calmer, but adds dead air).

# FLUX_EOT_TIMEOUT_MS=5000
#   Hard ceiling: end the turn after this much time regardless of confidence.

# FLUX_EAGER_EOT_THRESHOLD=0.5
#   Emits an early "probably finished" signal before the real end of turn. The
#   pipeline does not act on it yet — using it means starting the LLM
#   speculatively and cancelling if the caller keeps talking, which is not
#   implemented here. Setting it now only produces extra events.


# ---- Optional: turn taking (STT_PROVIDER=deepgram) -------------------------

# INTERRUPT_MIN_WORDS=2
#   Words the caller must say before a barge-in counts as an interruption while
#   the bot is speaking. Stops "mm-hm" and a cough from killing the bot's turn.
#   Once the bot is quiet, one word is always enough, so this does not make the
#   agent slower in ordinary back-and-forth. 0 disables the guard.
#   Ignored when STT_PROVIDER=deepgram_flux, which owns interruption itself.

# Silero VAD. These are Pipecat's own tuned defaults; the values below are what
# you get if you set nothing. VAD_STOP_SECS looks like the "make it snappier"
# dial and is really the "start truncating callers" dial — on the Flux path it
# does not affect responsiveness at all, and on the fallback path Smart Turn is
# what actually decides. VAD still runs on both paths because the latency
# measurements are anchored to its speech-start and speech-stop events.
# VAD_CONFIDENCE=0.7
# VAD_START_SECS=0.2
# VAD_STOP_SECS=0.2
# VAD_MIN_VOLUME=0.6


# ---- Optional: latency -----------------------------------------------------

# TTS_STREAM_TOKENS=false
#   true streams LLM tokens straight to the TTS websocket instead of buffering
#   whole sentences. Removes most of a sentence of latency on the first response
#   at some cost in prosody, because the vendor has to guess intonation from
#   fragments. Off by default; turn it on and listen before keeping it.

# LOG_METRICS=true
#   Logs one LATENCY line per response and a summary at the end of the session.


# ---- Optional: hearing yourself (no headphones) -----------------------------

# ECHO_SUPPRESSION=off
#   What to do about the agent hearing its own voice.
#
#   Without headphones, the agent's speech leaves the speakers, goes back in the
#   microphone, and is transcribed as the caller talking. The agent then answers
#   itself, and since each reply feeds the next the conversation runs away with
#   no human in it. In the transcript it is unmistakable — the "user" turn is the
#   agent's own previous sentence:
#
#       assistant: Hi there! How can I help you today?
#       user:      Hi there. How can I help
#       assistant: Oh, I think we might have crossed wires there!
#
#   Normally something cancels that echo before it reaches us, and every one of
#   those keeps barge-in working: headphones make the acoustic path physically
#   impossible, browsers run echo cancellation (Pipecat's client asks for it),
#   and phone networks cancel echo on the line. **Headphones are the fix.** This
#   setting is what is left when none of that is enough, which in practice means
#   a laptop on speaker.
#
#     off       Full barge-in — you can interrupt the agent at any moment.
#               Assumes the echo is being cancelled somewhere. The default,
#               because barge-in is a real feature and turning it off silently
#               would be worse than the echo.
#     greeting  No barge-in during the opening turn only. The greeting is the
#               longest uninterrupted stretch of agent audio in the call and it
#               plays before the caller has said anything, so an echo there
#               starts the loop before the conversation has begun.
#     always    The caller is ignored entirely while the agent is speaking. No
#               echo, and no barge-in either: you have to wait for it to finish.
#
#   If you are testing on a laptop with no headphones, set this to always.
# Default: off
# ECHO_SUPPRESSION=off


# ---- Optional: silence and connection handling -----------------------------

# USER_IDLE_TIMEOUT_SECS=12
#   Silence after the bot finishes speaking before it checks in. 0 disables.

# MAX_IDLE_PROMPTS=2
#   How many times it checks in before saying goodbye and ending the call.

# DISCONNECT_GRACE_SECS=5
#   How long a dropped connection is held open before the session is torn down.
#   A caller who reconnects inside this window keeps the whole conversation.
#   0 ends the session immediately on disconnect.

# SESSION_IDLE_TIMEOUT_SECS=300
#   Backstop: no speech in either direction for this long ends the session, so a
#   forgotten tab does not leak a live pipeline and a live STT websocket.
#   Note this timer starts when the pipeline starts. Under `-t eval` that is at
#   boot rather than at connect, so raise it when driving long eval suites.

# PEER_TIMEOUT_SECS=5
#   How long a browser connection may look dead before the bot believes the
#   caller has gone. This is *not* the same as DISCONNECT_GRACE_SECS above: that
#   one runs after a disconnect has been reported, and this one is what reports
#   it in the first place.
#
#   It exists because WebRTC has no way of telling you the far end went away. A
#   caller who presses disconnect closes the connection and says so; a caller
#   whose laptop sleeps, or whose wifi dies, says nothing at all — and without
#   this the session runs on forever with nobody on the other end, and the dev
#   runner keeps the dead connection registered under its id. The next time you
#   press connect, the browser sends that same id, the runner renegotiates the
#   corpse instead of starting a bot, and the page connects to silence. That is
#   the "it only works again after I refresh the page" symptom.
#
#   Detection is the same signal the transport already trusts: a keep-alive ping
#   in the last three seconds. Raise it if you are on a connection so bad that
#   real calls get dropped; 0 disables the watchdog and brings the bug back.
#   Default: 5

# ============================================================================
# KNOWLEDGE BASE (Phase 3)
# ============================================================================
#
# The agent answers from documents you load, not from what the model happens to
# remember. Documents are chunked, embedded locally, and stored in PostgreSQL
# with the pgvector extension; every caller turn is embedded and searched, and
# the passages that come back are put in front of the LLM for that one reply.
#
# Setup, once:
#   1. Install pgvector into your PostgreSQL.
#        Windows:  powershell -ExecutionPolicy Bypass -File scripts\install_pgvector.ps1   (elevated)
#        Linux/macOS:  your package manager, or `make && make install` from the pgvector source
#   2. Create the database:
#        createdb -U postgres voice_agent_kb
#   3. Set KB_DATABASE_URL below, then:
#        uv run ingest.py init
#        uv run ingest.py add evals/kb        # the sample documents, to try it out

# Turn the knowledge base off entirely. The agent then answers from the model's
# own knowledge, exactly as it did in Phase 2 — useful as the A/B baseline for
# what grounding is worth, and for running with no PostgreSQL at all.
# Default: true
# KB_ENABLED=true

# Where the knowledge base lives. Required unless KB_ENABLED=false. There is no
# default: a database only exists once you have made one.
KB_DATABASE_URL=

# The local model that turns text into vectors. 384 dimensions, 65 MB, English,
# no API key, downloaded on first use.
#
# Changing this invalidates everything already stored — vectors from different
# models are not comparable, and mixing them returns confident nonsense rather
# than an error. The store records the model per document and refuses to mix
# them; after a change, run `uv run ingest.py reset` and re-ingest.
# Default: BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where the model weights are cached.
# Default: ~/.cache/fastembed
# EMBEDDING_CACHE_DIR=

# How many passages are given to the LLM per turn. More raises the chance the
# answer is somewhere in there; it also lengthens every prompt, which costs time
# to first token on every single turn, and buries the best match among weaker
# ones.
# Default: 4
# KB_TOP_K=4

# Similarity floor, 0 to 1. Passages scoring below this are not shown at all.
#
# This does *less* than it looks like it does, and it is worth knowing which
# job is not its job. Measured on the sample knowledge base in evals/kb:
#
#   questions the documents answer            0.578 - 0.809
#   questions on the same topic, not answered 0.519 - 0.642   <- overlaps
#   greetings, thanks, unrelated remarks      0.456 - 0.566
#
# The middle band overlaps the first, and no threshold separates them: a
# passage about pricing genuinely is the closest thing to a question about
# pricing, it simply does not contain the answer. So this setting does not
# decide whether the agent admits it does not know — the LLM decides that, from
# the passages and the instruction attached to them. This floor only strips
# obvious noise, which is why the default sits below the worst real question
# rather than between the bands: a weak passage let through costs a few tokens,
# one wrongly dropped costs an answer you had.
#
# Raise it if the agent volunteers irrelevant material; lower it if it says it
# does not know something your documents clearly cover. Check either with:
#   uv run ingest.py search "the question that went wrong"
# Default: 0.5
# KB_MIN_SCORE=0.5

# A caller message shorter than this many words is searched together with their
# previous message, so "how much is it?" still finds the right passage instead
# of matching nothing on its own.
# Default: 6
# KB_SHORT_QUERY_WORDS=6

# Chunking, applied at ingest time. Changing either means re-ingesting: the
# stored chunks were cut with the old values.
#
# Chunk size is a retrieval decision. Too large and one vector averages several
# topics, so the match is vague and the agent gets a page where it needed a
# sentence; too small and the context that made a sentence meaningful is in the
# neighbouring chunk. 60 words is tuned for *spoken* answers, which are one to
# three sentences long. Measured on the sample knowledge base, 60/15 put the
# correct passage first for 15 of 15 answerable questions; 120/30 managed 13.
# Default: 60 words, 15 words of overlap
# KB_CHUNK_WORDS=60
# KB_CHUNK_OVERLAP_WORDS=15

# When the knowledge base is searched at all.
#
#   auto      Only on turns that could be asking for a fact — anything with a
#             question mark, an interrogative, or a commercial noun in it. A
#             sales call is mostly *not* questions ("yeah", "we do it by hand",
#             "next quarter probably"), and searching a document store for each
#             of those returns confident, on-topic, irrelevant passages and
#             attaches them to a turn nobody asked anything in.
#   always    Phase 3's behaviour: every single turn, unconditionally.
#
# The gate is written to skip rather than to allow, so the default answer is
# still to search: a turn wrongly searched costs one indexed query, and a turn
# wrongly skipped costs the grounding the knowledge base exists to provide.
# Default: auto
# KB_RETRIEVAL_MODE=auto


# ============================================================================
# THE SALES CONVERSATION (Phase 6)
# ============================================================================
#
# Who the agent says it is, what it is allowed to claim, and what it asks for.
#
# **Nothing here is required, and nothing here is guessed.** Leave a value unset
# and the agent is *told* it does not have it: with no SALES_COMPANY_NAME it
# introduces itself by name only and is forbidden from inventing a company, and
# with no SALES_VALUE_POINTS it makes no claims about the product at all and
# offers to have a specialist confirm anything factual. The startup log names
# every gap, so running without them is a decision rather than a surprise heard
# on a live call.
#
# Per-campaign overrides: everything below is the default for every call, and a
# campaign's `configuration` JSON overlays it field by field. The keys are the
# same names in lower case — offer, value_points, meeting_ask, company_name,
# agent_name, qualification_criteria, notes, company_description, services.
# The company facts (company_description, services) travel with the company
# name: a campaign that names a different company inherits neither, so one
# deployment can run campaigns for more than one business.

# Turn the whole sales layer off and run the Phase 3 assistant instead: the
# general system prompt, no tools, no conversation state, no per-turn guidance.
# The A/B baseline for what this phase is worth.
# Default: true
# SALES_MODE=true

# The name the agent introduces itself with.
SALES_AGENT_NAME=Alex

# The business it is calling on behalf of. Unset means it will not name one.
SALES_COMPANY_NAME=Meridian Fleet Systems

# One plain sentence on why you are calling. It is not a script — the agent
# writes its own words — it is what the call is about.
SALES_OFFER=fleet tracking that cuts fuel spend and shows where every vehicle is

# The ONLY claims the agent may make about what you do. Separated by |, because
# every one of these is a sentence and sentences contain commas.
#
# This is the setting that decides what the agent is able to say about the
# product. With none set, it says nothing about it. With three set, it says
# those three and nothing else — anything beyond them is an invention, and the
# system prompt tells it so in as many words.
SALES_VALUE_POINTS=Customers typically cut fuel spend by around a tenth in the first year.|Every vehicle's position and idling time is visible in one place.|It installs in under an hour per vehicle with no workshop time.

# What makes somebody worth a salesperson's time. Guidance for the qualification
# stage, in your words. Separated by |.
SALES_QUALIFICATION_CRITERIA=They run ten or more vehicles.|Fuel or utilisation is a cost they have complained about.|They have a say in choosing a supplier.

# The next step to ask for, in the words a person would use.
SALES_MEETING_ASK=a fifteen minute call with a specialist later this week

# Always-available campaign context (Phase 28): one or two plain sentences on
# what the company is and does, and the services it may name. The agent
# answers "what do you actually do?" and "who are you?" from these without a
# knowledge base lookup — a question a retrieval happens to miss no longer
# makes it say it has no information. Keep them short: they are sent on every
# request, and the detail belongs in the knowledge base.
SALES_COMPANY_DESCRIPTION=Meridian Fleet Systems builds fleet management software for mid-sized logistics operators, sold as a subscription with no hardware to buy.
SALES_SERVICES=live vehicle tracking|route planning|maintenance scheduling|driver safety scoring

# Anything else every call should know. Separated by |.
# SALES_CAMPAIGN_NOTES=


# ---- Optional: a prospect for development and eval runs ---------------------
#
# A call placed by `campaign.py` carries its prospect's id, and the agent looks
# the person up. A browser session and an eval run carry nothing, so the agent
# is anonymous — which is correct, and makes it impossible to test whether
# personalisation works.
#
# These fill that gap. They are used ONLY when a call carries no prospect id:
# a campaign call whose prospect could not be found stays anonymous rather than
# being told it is speaking to whoever this file last described. Greeting a
# stranger by a test fixture's name is exactly the failure this phase is
# arranged to prevent.
#
# DEV_PROSPECT_FIRST_NAME=Sarah
# DEV_PROSPECT_LAST_NAME=Khan
# DEV_PROSPECT_COMPANY=Ravi Logistics
# DEV_PROSPECT_JOB_TITLE=Operations Director
# DEV_PROSPECT_INDUSTRY=Road freight
# DEV_PROSPECT_LOCATION=Lahore
# The attendee of a meeting booked on such a call. Cal.com refuses a domain
# that cannot receive mail (example.com gets HTTP 400
# email_domain_cannot_receive_mail), so for a real booking set this to an
# address of your own — in `.env`, or in the shell when running the eval
# suite (`DEV_PROSPECT_EMAIL=you@yourcompany.com uv run python -m
# pipecat.evals suite evals/sales/suite.yaml ...`; evals/eval_env.py lets a
# shell value win over this file). The local calendar needs no email.
# DEV_PROSPECT_EMAIL=sarah.khan@example.com
# DEV_PROSPECT_NOTES=


# ============================================================================
# TELEPHONY (Phase 4)
# ============================================================================
#
# Lets the agent talk to somebody on a real phone. Everything here is optional:
# with none of it set the bot still runs, still serves the browser client, and
# still runs the eval suite — it just cannot dial out. That is deliberate, so
# that developing the agent does not require a carrier account.
#
# How a phone call reaches the bot:
#
#   call.py  --REST-->  the carrier  --dials-->  the person
#                            |
#                            '--websocket--> this bot's /ws  (audio, both ways)
#
# So the carrier has to be able to *reach this machine* from the internet. In
# development that means a tunnel:
#
#   1. uv run bot.py                     # terminal 1, serves /ws on port 7860
#   2. ngrok http 7860                   # terminal 2, prints an https URL
#   3. put that URL in TELEPHONY_PUBLIC_URL below
#   4. uv run call.py +923001234567      # terminal 3
#
# The URL changes every time a free ngrok restarts, so expect to update it.
# `uv run bot.py` prints the exact wss:// address carriers will be sent to.
#
# ---- No account? You can still test the whole path -------------------------
#
# `tests/fake_carrier.py` connects to the bot's /ws and speaks a carrier's
# media-stream protocol at it — handshake, 8kHz mulaw, the lot. It needs no
# account, no tunnel and no money, and it is how the telephony path is checked
# on a machine with no carrier at all:
#
#   uv run bot.py                                   # terminal 1
#   uv run python tests/fake_carrier.py             # terminal 2
#
# It cannot tell you whether your carrier accepts the markup or whether a real
# number rings. For that you need a real call, which is what the rest of this
# section configures.


# ---- Which carrier ---------------------------------------------------------

# Who places outbound calls: 'twilio' or 'signalwire'.
#
#   twilio      The reference implementation. Best documentation and the
#               broadest reach. Trial accounts are not available in every
#               country — Pakistan among them — so check before planning on it.
#
#   signalwire  A deliberate reimplementation of Twilio's API: same markup, same
#               call statuses, same media-stream protocol. The free trial needs
#               no credit card, includes a phone number, and lets you call one
#               number you have verified — which is exactly the shape of a
#               development test. Use this when Twilio will not take you.
#
# The bot is identical either way. Only the four lines below change.
# Default: twilio
# TELEPHONY_PROVIDER=twilio


# ---- Twilio (TELEPHONY_PROVIDER=twilio) ------------------------------------

# https://console.twilio.com — both are on the dashboard; the account SID
# starts with AC. Never commit these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=


# ---- SignalWire (TELEPHONY_PROVIDER=signalwire) ----------------------------

# https://signalwire.com — sign up, then "API" in the sidebar.
#
#   SIGNALWIRE_PROJECT_ID   the Project ID (a UUID), shown on that page
#   SIGNALWIRE_API_TOKEN    an API token you create there. Never commit it.
#   SIGNALWIRE_SPACE_URL    your space, shown at the top of the dashboard.
#                           Every account gets its own subdomain, so there is no
#                           default. Either spelling works:
#                             example.signalwire.com
#                             https://example.signalwire.com
#
# Then buy a number under Phone Numbers, and verify the number you want to call
# — in trial mode that is the only number you are allowed to dial.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=


# ---- The call itself (any carrier) -----------------------------------------

# The caller ID to present, in E.164. It must be a number your account owns or
# has verified.
#
# Local +92 numbers are not generally sold by either carrier, so a Pakistani
# prospect will see a foreign caller ID. That is a business problem, not a
# technical one, and it is worth knowing before the first campaign: answer rates
# for unknown international numbers are poor.
TELEPHONY_FROM_NUMBER=

# Where the carrier streams the call's audio — the public address of *this*
# bot's runner. Accepts either spelling: https://abc123.ngrok.app becomes
# wss://abc123.ngrok.app/ws. No default, because a tunnel address is different
# every time.
TELEPHONY_PUBLIC_URL=

# The runner's telephony websocket route. Pipecat's dev runner serves /ws;
# change this only if you mount it somewhere else.
# Default: /ws
# TELEPHONY_STREAM_PATH=/ws

# How long to let a number ring before recording a no-answer. A carrier's own
# default is usually 60 seconds, which is long enough to reach most voicemail
# systems. 30 is shorter on purpose: on a cold call, a no-answer is a result to
# record and move on from, and waiting longer mostly buys voicemail greetings.
# Default: 30
# TELEPHONY_ANSWER_TIMEOUT_SECS=30

# How long a dropped *phone* call is held open before the session ends. This is
# not the same knob as DISCONNECT_GRACE_SECS above, and the default is
# different, because the two drops are different events: a browser's WebRTC
# connection blips and recovers into the same session, while a phone call that
# drops is over — the person redials and gets a new call. Waiting only keeps a
# dead pipeline and a live STT websocket alive.
#
# Raise it only if you are on a carrier that genuinely reconnects the same media
# stream after a drop.
# Default: 0
# TELEPHONY_DISCONNECT_GRACE_SECS=0


# ---- Call status webhooks (Phase 14) ----------------------------------------
#
# Every call placed asks the carrier to POST its lifecycle events — initiated,
# ringing, answered, completed, busy, no-answer, failed, canceled — to this
# system as they happen, so the attempt is written the moment the call changes
# rather than on the next poll. Each delivery is checked against the carrier's
# own signature before anything reads it (Twilio signs with the auth token
# above; SignalWire with a separate signing key, below), recorded on a ledger
# (`campaign.py webhooks` shows it), and applied once: a redelivery is a
# no-op, a late event cannot walk a finished call backwards, and an event for a
# call this database never placed is recorded and ignored.
#
# Polling is not removed. The worker still asks the carrier about every call it
# follows — every WORKER_POLL_SECS until the first event for that call arrives,
# then every WORKER_WEBHOOK_POLL_SECS as a safety net. So a receiver that is
# unreachable costs nothing but the old request rate.
#
# The events go to TELEPHONY_PUBLIC_URL + TELEPHONY_WEBHOOK_PATH, the same
# public address the audio uses, so a single tunnel serves both.

# Ask the carrier for events at all. false places calls exactly as Phase 13 did.
# Default: true
# TELEPHONY_WEBHOOKS=true

# Who serves the route. `bot` mounts it on the bot's own web server — the one
# address a tunnel gives you; the handler verifies a signature and writes two
# rows, and never touches the audio pipeline. `standalone` leaves the bot alone
# and expects `uv run webhooks.py` (port 7880) behind the same public address,
# with a proxy routing TELEPHONY_WEBHOOK_PATH to it and /ws to the bot.
# Default: bot
# TELEPHONY_WEBHOOK_RECEIVER=bot

# The route. Change it only if something else already owns that path.
# Default: /webhooks/telephony
# TELEPHONY_WEBHOOK_PATH=/webhooks/telephony

# SignalWire only: the webhook signing key from the dashboard's API credentials
# page. SignalWire signs its deliveries with this, not with the API token, and
# without it no delivery could be verified — so none is asked for, and call
# status is polled as before. The startup line says which. Twilio needs
# nothing here: it signs with TWILIO_AUTH_TOKEN.
# SIGNALWIRE_SIGNING_KEY=

# Where `transfer_to_human` sends a live call (Phase 7). A person's phone, in
# E.164. When a prospect asks for a human and agrees to be connected, the agent
# calls the tool and the carrier redirects the call to this number — a blind
# transfer; the agent leaves the call. Unset means the agent cannot transfer:
# it is told so, and offers a callback from a colleague instead. Needs the
# carrier credentials above, because the redirect is a REST call.
# Default: unset (no transfers)
# TELEPHONY_TRANSFER_NUMBER=+923001234567

# Phase 16: how long a transfer rings the colleague before the prospect is
# told nobody is available. How the ring ended (answered, busy, no answer,
# failed) is reported by the carrier to the webhook receiver (Phase 14) and
# recorded on `call_transfers` — `campaign.py transfers` lists them. Without
# a receiver the fallback still plays, but the outcome is never known.
# Default: 30
# TELEPHONY_TRANSFER_TIMEOUT_SECS=30


# ============================================================================
# PROSPECTS AND CAMPAIGNS (Phase 5)
# ============================================================================
#
# Who to call, which campaign they belong to, and what happened on each dial.
# Managed with `campaign.py`:
#
#   uv run campaign.py init                            # create the tables, once
#   uv run campaign.py import leads.csv --dry-run      # check the column mapping
#   uv run campaign.py import leads.csv
#   uv run campaign.py create "Q1 Outreach"
#   uv run campaign.py add "Q1 Outreach" --all
#   uv run campaign.py start "Q1 Outreach"
#   uv run campaign.py next "Q1 Outreach"              # who is up, dialling nothing
#   uv run campaign.py call "Q1 Outreach"              # actually place one call

# Where prospects, campaigns and call history live.
#
# Defaults to KB_DATABASE_URL, so an existing setup needs nothing new and both
# sets of tables share one database. It is a separate setting because the two
# are separable: the knowledge base can be switched off entirely with
# KB_ENABLED=false, and the campaign tables cannot — there is no version of this
# product without prospects.
# Default: the value of KB_DATABASE_URL
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/voice_agent_kb

# The country to assume for phone numbers written without a country code.
#
# This is the most consequential setting in this section. With it set to PK, all
# of these are recognised as one number and one person:
#
#     +92 322 1234567      +923221234567
#     0092 322 1234567     0322 1234567
#
# With it unset, the first three still work — they carry their country with
# them — and `0322 1234567` is *refused*, because a leading-zero local number is
# valid in many countries and choosing one would be a guess. A guess here does
# not fail safely: it dials a real stranger.
#
# So set it to the country your prospect lists are written in, and leave it
# unset if they always carry country codes. Two-letter code: PK, US, GB, AE.
# Default: unset (refuse local-format numbers rather than guess)
# DEFAULT_PHONE_REGION=PK

# How many times one prospect may be dialled for one campaign before that
# membership is exhausted. Counted per campaign, so the same person in two
# campaigns gets this many attempts in each.
# Default: 3
# CAMPAIGN_MAX_ATTEMPTS=3

# How long to wait before offering a no-answer or busy again. Only those two
# outcomes are retried: a call that outright failed usually means the number is
# wrong, and retrying a wrong number only spends money.
# Default: 60
# CAMPAIGN_RETRY_MINUTES=60


# ============================================================================
# ACTIONS: CALENDAR, CALLBACKS, TRANSFER (Phase 7)
# ============================================================================
#
# What the agent can actually *do* during a call, beyond talking and recording.
# Every action is a tool with a strict schema, handled by a backend that
# validates it and answers success true or false — and the agent is forbidden
# from saying a meeting is booked, a callback is scheduled or a call is being
# transferred unless the tool said success. So every setting here changes what
# the agent is *told it can do*: a bot with no calendar is told it has none and
# says a colleague will confirm, rather than being left to pretend.
#
# Two of these tables are new. On an existing database run, once:
#     uv run campaign.py init
# Then see what the agent did:
#     uv run campaign.py meetings
#     uv run campaign.py callbacks --due

# Which calendar meetings are booked into.
#
#   none    The agent cannot book. It records that a meeting was agreed and says
#           a colleague will confirm the time. The Phase 6 behaviour.
#   local   A real calendar in this system's own database: slots on a grid
#           inside the business hours below, minus what is already booked in
#           the `meetings` table. Needs no account, and `campaign.py meetings`
#           is the diary. A booking here is a booking *in this system* — nothing
#           reaches a sales rep's own calendar — and the agent's confirmation is
#           true in exactly that sense. The default, so the whole flow works and
#           can be tested out of the box.
#   calcom  Books into a Cal.com event type through its API, so the invitation
#           really arrives. Needs CALCOM_API_KEY and CALCOM_EVENT_TYPE_ID. Cal.com
#           requires an attendee email, so the agent asks for one before booking.
#           Written against the documented API and not yet exercised against a
#           live account — see HANDOFF.md.
# Default: local
# CALENDAR_PROVIDER=local

# The timezone the calendar keeps, the agent is told the time in, and the tools
# expect times in. The agent works "next Tuesday at ten" out from this. An IANA
# name. Set it to where your prospects are; UTC is only right if they are.
# Default: UTC
# CALENDAR_TIMEZONE=Asia/Karachi

# Slot length in minutes, and for Cal.com the event type's length.
# Default: 30
# CALENDAR_SLOT_MINUTES=30

# When the local calendar offers slots. Hours as HH:MM-HH:MM in the timezone
# above; days as a range (mon-fri) or a list (mon,wed,fri). Cal.com applies its
# own availability and ignores these.
# Default: 09:00-17:00 mon-fri
# CALENDAR_BUSINESS_HOURS=09:00-17:00
# CALENDAR_BUSINESS_DAYS=mon-fri

# The furthest day the agent may check or book. A prospect asking for "some
# time next quarter" gets "a colleague will arrange it" rather than a slot.
# Default: 30
# CALENDAR_MAX_DAYS_AHEAD=30

# Nothing is offered sooner than this many minutes from now. A meeting agreed
# for ten minutes' time on a cold call is one nobody turns up to.
# Default: 60
# CALENDAR_MIN_NOTICE_MINUTES=60

# Cal.com, when CALENDAR_PROVIDER=calcom. The key is created under Settings ->
# Developer -> API keys; the event type id is the number in the event type's URL
# in the Cal.com dashboard. CALCOM_API_BASE is only for a self-hosted instance.
# CALCOM_API_KEY=cal_live_...
# CALCOM_EVENT_TYPE_ID=123456
# CALCOM_API_BASE=https://api.cal.com/v2

# Phase 16: ceiling on one Cal.com request. It is made inside a tool turn with
# a person on the line. A booking that exceeds it is *looked up*, not repeated:
# Cal.com may have created it, and a second POST could create two.
# Default: 15
# CALCOM_TIMEOUT_SECS=15

# How far ahead a callback may be scheduled, in days. The agent asks for an
# exact day and time, the backend refuses the past and anything beyond this, and
# a scheduled callback puts the prospect back in the campaign queue for that
# moment — which the queue then honours, because it already refuses to hand out
# anything before its `next_attempt_at`.
# Default: 60
# CALLBACK_MAX_DAYS_AHEAD=60


# ---- Optional: safety limits (Phase 9) -------------------------------------
# The settings that decide whether a stranger's phone rings at four in the
# morning. Every default here is the safe end of its trade: calling hours are
# enforced, one call at a time, and a call has a ten-minute ceiling. A campaign
# that wants more throughput has to say so.
#
# `uv run campaign.py call` prints the active limits before it dials anything,
# and `uv run bot.py` prints them at startup on the `Safety:` line.

# When a prospect may be phoned. Same syntax as CALENDAR_BUSINESS_HOURS: hours
# as HH:MM-HH:MM, days as a range (mon-fri) or a list (mon,wed,fri).
#
# Applied in the *prospect's* timezone when their imported record supplies one
# — a `timezone` column in the CSV, kept in custom_data — and in
# CALLING_TIMEZONE otherwise. It is never inferred from the phone number: a
# country code does not determine a timezone (Pakistan is one zone, the United
# States is six), and a guess puts the call at the wrong hour with nothing to
# show that it did.
# Default: 09:00-18:00 mon-fri
# CALLING_HOURS=09:00-18:00
# CALLING_DAYS=mon-fri

# The timezone the hours above are applied in for prospects whose own is not
# known. Defaults to CALENDAR_TIMEZONE, so a bot booking meetings in Karachi
# calls during Karachi hours without being told twice.
# CALLING_TIMEZONE=Asia/Karachi

# false allows calls at any hour. For ringing your own phone in the evening
# while testing — not for a campaign. Printed at startup either way.
# Default: true
# ENFORCE_CALLING_HOURS=true

# How many calls may be live at once, across every campaign. One is the honest
# default: one bot per process is how this runs, and two concurrent calls on a
# machine running Silero, Kokoro and Moonshine locally is not more throughput.
#
# An attempt whose placement never reported an outcome counts as live, so an
# ambiguous call holds a slot until `campaign.py recover` resolves it. That is
# deliberate: the cost is one uncalled prospect, and the alternative is a second
# call to somebody whose phone may already be ringing.
# Default: 1
# MAX_CONCURRENT_CALLS=1

# Minimum seconds between placements. 0 is unpaced. Not politeness: a carrier
# that is rate-limiting and a bug that empties the queue in a loop both look
# like "many calls very quickly", and a floor turns either into a slow problem.
# In-process, so a second dialer would halve the interval — it is about rate,
# not correctness. What stops duplicate calls is in the database.
# Default: 0
# CALL_PACING_SECS=0

# Hard ceiling on one call, in seconds, enforced by the bot on itself. The
# agent is asked to say a closing line and the session ends when it has played;
# if it never plays, the session ends anyway. A call that never ends costs money
# for as long as it lasts. 0 disables.
# Default: 600
# MAX_CALL_SECS=600

# How long one inference may run without finishing before the call is treated
# as stalled. Generous, because a throttled turn on a free tier legitimately
# takes tens of seconds and cutting those off would break working calls.
#
# It also sets the LLM's own HTTP timeout, at 80% of this value, so the request
# is abandoned by the network layer before the bot gives up on it. Without one
# the OpenAI client waits ten minutes by default. 0 disables both.
# Default: 60
# LLM_STALL_SECS=60

# Consecutive failures from one pipeline stage (STT, LLM, TTS) before the call
# is ended deliberately rather than left in silence. Consecutive is the word
# that matters: three failures across a long call are three blips, and three in
# a row are an outage. A success from that stage resets the count.
#
# One failure is always enough if the agent has not yet spoken at all, whatever
# this is set to — a call whose greeting never happens has nothing to recover
# to, and nothing else would trigger another attempt. 0 disables the threshold.
# Default: 3
# MAX_SERVICE_FAILURES=3

# Ceiling on one HTTP request to the carrier. Without it aiohttp waits five
# minutes, which for a placement means an outcome nobody learns for five
# minutes. A placement that exceeds this is treated as *ambiguous*, never as a
# failure: the request may have been received.
# Default: 20
# CARRIER_TIMEOUT_SECS=20

# How stale a live call attempt must be before `campaign.py recover` will touch
# it. A healthy call two seconds old is indistinguishable from an abandoned one
# except by age, and reconciling a live call would end it.
# Default: 120
# RECOVERY_MIN_AGE_SECS=120

# Ceiling on one health check in `uv run health.py`.
# Default: 6
# HEALTH_TIMEOUT_SECS=6


# ---- Optional: logging (Phase 9) -------------------------------------------
# LOG_FORMAT=json emits one JSON object per line carrying the call's ids
# (campaign, prospect, attempt, call, provider) as fields, which is what a log
# shipper or `jq` wants. `text` is the readable default and shows the same ids
# in brackets at the end of each line.
#
# Either way, every configured credential's value is replaced with *** in every
# record, including exception text. That is a backstop, not a licence: nothing
# should be putting a key in a log line in the first place.
# Default: text
# LOG_FORMAT=text
# LOG_LEVEL=INFO


# ---- Optional: cost tracking (Phase 11) ------------------------------------
# What this account actually pays per unit. Every rate is optional and none is
# guessed: a price is a commercial arrangement this code cannot know, it
# changes without notice, and it differs per account. Leave them unset and the
# system still *measures* every call — tokens, characters, audio seconds — and
# simply does not put a number on it.
#
# `uv run bot.py` prints which rates are configured at startup, every call logs
# a USAGE line, and the dashboard shows tokens and cost per call.
#
# One honest caveat: a stage is priced only when the provider actually reported
# its usage. In Pipecat 1.8.1 Cartesia's TTS reports characters and Deepgram's
# websocket TTS does not, so a call on Deepgram TTS lists `tts` under
# `unmeasured` rather than pricing it at zero — a total quietly missing a stage
# would be worse than one that says which stage is missing.

# Dollars per million LLM tokens, input and output. Look them up on your
# provider's pricing page for the model in <PROVIDER>_MODEL.
# COST_LLM_INPUT_PER_MTOK=0.29
# COST_LLM_OUTPUT_PER_MTOK=0.39

# Dollars per million TTS characters.
# COST_TTS_PER_MCHAR=65

# Dollars per minute of audio transcribed.
# COST_STT_PER_MINUTE=0.0077

# Dollars per minute of call, from your carrier's rate for the destination.
# Outbound rates vary by country far more than any other line here.
# COST_TELEPHONY_PER_MINUTE=0.014


# ============================================================================
# VOICE QUALITY AND VOICEMAIL (Phase 12)
# ============================================================================
#
# What is measured on every call, what is done when an interruption turns out
# to be noise, and what happens when an answering machine picks up. None of
# this changes the audio pipeline; every default is the one a first real call
# wants. Each phone call also leaves a JSON report behind — see CALL_REPORT_DIR
# — which is what `tests/live_call.py` and `tests/phone_drill.py` read.

# ---- Turns -------------------------------------------------------------------

# A caller turn with words in it that has produced no bot audio after this many
# seconds is logged as a failed turn (`turn.failed | ...`). Generous by default:
# on the free Groq tier a throttled tool turn legitimately takes tens of
# seconds, and that is a slow turn, not a failed one. A turn that is waiting on
# a tool call is never counted. 0 disables the check.
# Default: 10
# TURN_RESPONSE_TIMEOUT_SECS=10

# When the caller's turn interrupts the agent and then closes with no words in
# it — a cough, a door, the agent's own echo — the agent has been silenced for
# nothing, and nothing else will make it speak until the idle nudge twelve
# seconds later. With this on it is asked to pick up where it left off, at most
# NOISE_RESUME_MAX times per call. Logged as `turn.spurious_interruption` and
# `turn.noise_resume`.
# Default: true, 3
# NOISE_RESUME=true
# NOISE_RESUME_MAX=3

# Where each phone call's report is written, as `<call id>.json`: every turn
# with its latency, every barge-in with how fast the bot stopped, every failed
# turn, the voicemail verdict, and how the call ended. Relative to server/.
# `off` disables it. Browser and eval sessions write none.
# Default: call-reports
# CALL_REPORT_DIR=call-reports

# ---- Answering machines ------------------------------------------------------

# The bot's own detection, from what the line sounds like. Phone calls only.
#
#   heuristic  Watch the first caller turns for phrases only a recording says
#              ("leave a message after the tone") and for a greeting that runs
#              on past VOICEMAIL_MAX_GREETING_SECS without pausing. Needs
#              nothing from the carrier, so it works over tests/fake_carrier.py.
#   off        Talk to the voicemail as before.
# Default: heuristic
# VOICEMAIL_DETECTION=heuristic

# What to do when a machine is detected.
#
#   hangup   End the call at once. The cheap choice, and the default.
#   message  Wait for the greeting to end, then VOICEMAIL_MESSAGE_DELAY_SECS
#            for the beep, speak VOICEMAIL_MESSAGE, and hang up. The beep is
#            NOT detected — a tone is not speech — so the delay is a guess.
# Default: hangup
# VOICEMAIL_ACTION=hangup

# The message left on a machine. Spoken word for word, no model involved.
# Empty means a short default built from SALES_AGENT_NAME and SALES_COMPANY_NAME.
# VOICEMAIL_MESSAGE=Hi, this is Alex from Meridian. Sorry I missed you, I'll try again another time.

# A first caller turn that runs longer than this without a pause is a
# recording. A person who answers says "hello?" and stops; a greeting talks.
# 0 disables the length rule and leaves only the phrases.
# Default: 8
# VOICEMAIL_MAX_GREETING_SECS=8

# Only this much of the start of the call is judged, and only the first two
# caller turns. A person who tells a long story two minutes in is a prospect.
# Default: 30
# VOICEMAIL_WINDOW_SECS=30

# How long after the greeting's turn ends to wait before speaking the message.
# Default: 2
# VOICEMAIL_MESSAGE_DELAY_SECS=2

# Override the phrase list, separated by |. Unset means the built-in list in
# src/voicemail.py. Keep entries to things a person answering does not say.
# VOICEMAIL_PHRASES=leave a message|after the tone|not available to take your call

# ---- Carrier-side detection --------------------------------------------------

# Ask the carrier to run its own answering-machine detection when the call is
# placed. Both Twilio and SignalWire support it; Twilio charges a small fee per
# call for it. The verdict arrives on the call resource as `answered_by`, which
# the bot polls for TELEPHONY_AMD_WINDOW_SECS after the audio connects, and
# which `campaign.py` and `call.py` read when they refresh the call. No
# webhook is needed.
#
#   off    Send nothing. The bot's own heuristic still runs.
#   async  Detect in the background: the call connects at once, so a person
#          hears no delay, and the verdict lands a few seconds later.
#   sync   Decide before connecting: the verdict is known when the bot
#          answers, at the cost of two to four seconds of silence for every
#          person who picks up. Not recommended for a cold call.
#
# Not yet exercised against a live account; see HANDOFF.md.
# Default: off
# TELEPHONY_MACHINE_DETECTION=off
# TELEPHONY_AMD_POLL_SECS=2
# TELEPHONY_AMD_WINDOW_SECS=20


# ============================================================================
# THE SCHEDULER (Phase 13)
# ============================================================================
# `uv run campaign.py run` places calls unattended for every ACTIVE campaign:
# recovery first, then due callbacks, then the queue, each call through the
# same dialer and the same safety limits as `campaign.py call`, followed to its
# end and written back. It is a separate process from the bot, which must be up
# to answer the calls it places. Nothing below decides *whether* a call may be
# placed — that is the Phase 9 section above and the campaign's own rules.
# These decide how often the worker looks.

# How often a call in progress is checked with the carrier, and the shortest
# the loop sleeps when it has work. Each check is one carrier API request per
# live call.
# Default: 2
# WORKER_POLL_SECS=2

# The longest the loop sleeps. It wakes at least this often to notice a
# campaign that was just started, a callback that fell due, or a pause — so
# this is the most a newly activated campaign waits before its first call.
# Default: 30
# WORKER_IDLE_SECS=30

# How often the recovery pass runs while the worker is up, for attempts the
# worker is not following itself (an ambiguous placement, a call another
# process placed). It also runs at startup, always. 0 runs it at startup only.
# Default: 300
# WORKER_RECOVERY_INTERVAL_SECS=300

# After Ctrl+C, how long to keep following the calls already in progress
# before giving up on them. They are left live and the next start's recovery
# pass resolves them. A second Ctrl+C stops at once.
# Default: 900
# WORKER_DRAIN_SECS=900

# How often the `worker.metrics` line — queued, started, completed, failed,
# skipped, and the breakdown of each — is logged.
# Default: 60
# WORKER_REPORT_SECS=60

# Mark a campaign COMPLETED by itself once it has nothing left it could ever
# dial: nothing due, nothing scheduled, nothing on the phone, no pending
# callback. Memberships that can never be dialled (no usable number, out of
# attempts) are closed as SKIPPED or EXHAUSTED first. false leaves campaigns
# ACTIVE for a person to close.
# Default: true
# WORKER_AUTO_COMPLETE=true

# Phase 14. Once the carrier has pushed at least one event for a call (see the
# webhooks section above), how often the worker still asks the carrier about
# it — the safety net under the webhooks, not the source of truth. Until the
# first event arrives a call is polled every WORKER_POLL_SECS as before. The
# tick itself still runs every WORKER_POLL_SECS, reading the row, so a pushed
# ending is noticed as fast as a polled one. 0 polls every tick regardless.
# Default: 30
# WORKER_WEBHOOK_POLL_SECS=30

# --- Several workers at once (Phase 21) -------------------------------------
# Any number of `campaign.py run` processes, on one machine or many, share one
# queue, one concurrency limit (MAX_CONCURRENT_CALLS, counted across all of
# them) and one pacing clock (CALL_PACING_SECS, and a campaign's own
# `pacing_secs`) through PostgreSQL. Nothing else to run. Run
# `uv run campaign.py init` once so the scheduler_workers and scheduler_state
# tables exist; `uv run campaign.py workers` shows the fleet and the queue.

# A name for this process in the fleet, shown by `campaign.py workers` and
# written onto every call it places. A unique suffix is always appended, so
# two processes with the same name never share a heartbeat row.
# Default: <hostname>-<pid>
# WORKER_ID=

# How often a worker writes its heartbeat.
# Default: 10
# WORKER_HEARTBEAT_SECS=10

# A worker whose last heartbeat is older than this is dead: the calls it was
# following are adopted by a live worker and the reservations it never placed
# go back to the queue. Must be well above WORKER_HEARTBEAT_SECS (at least
# three beats), or a worker on a slow database is declared dead mid-call and
# its calls counted twice.
# Default: 60
# WORKER_STALE_SECS=60

# How often each worker looks for the calls and reservations of dead workers.
# Default: 30
# WORKER_ADOPT_SECS=30

# Queue a prospect again when a placement failed for a reason that was the
# system's, not theirs: the carrier unavailable, a timeout, a 5xx, a worker
# that died with the reservation, a recovery pass that closed an attempt the
# carrier never confirmed. Counts against CAMPAIGN_MAX_ATTEMPTS like any other
# attempt. A refusal about the number itself (invalid, blocked) is never
# retried. false leaves every FAILED attempt final, as before Phase 21.
# Default: true
# WORKER_RETRY_TRANSIENT_FAILURES=true

# How long to wait before that retry. Empty uses CAMPAIGN_RETRY_MINUTES (or
# the campaign's own retry policy).
# Default: (CAMPAIGN_RETRY_MINUTES)
# WORKER_TRANSIENT_RETRY_MINUTES=


# ============================================================================
# CRM SYNC (Phase 15)
# ============================================================================
# Every finished call already has a CallResult row (Phase 8). With a CRM
# configured, `uv run campaign.py crm-sync` files each one with it: the person
# as a contact (matched by email, then phone; created if absent) and the call
# as an activity carrying the outcome, summary, qualification, pain points,
# objections, meeting, callback and next action — with the structured facts
# also written onto the contact as custom properties.
#
# It is a separate process from the bot and never touches a call in progress:
#   uv run campaign.py crm-sync            # until Ctrl+C
#   uv run campaign.py crm-sync --once     # one pass, for cron
#   uv run campaign.py crm-status          # what is filed, retrying, failed
#   uv run campaign.py crm-retry --all-failed
# Each result is filed once (a crm_sync row per result); a result that changes
# after it was filed — the conversation's rich result replacing the carrier's
# thin one — updates the same activity. Transient failures back off and retry;
# refusals are closed with the CRM's own words for a person to read.

# Which CRM: none (default) or hubspot. Adding another is a module in src/crm/.
# CRM_PROVIDER=none

# HubSpot: a private app's access token. Settings → Integrations → Private
# Apps. Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.calls.read, crm.objects.calls.write, and — for the ai_* contact
# properties — crm.schemas.contacts.write. Never commit it.
# HUBSPOT_ACCESS_TOKEN=

# File the structured facts as custom `ai_*` contact properties (created on the
# first run). false keeps to standard fields; the call body still carries
# every fact either way.
# Default: true
# CRM_CUSTOM_PROPERTIES=true

# File calls nobody answered too (no answer, busy, voicemail, failed). A CRM's
# call log is the record of every attempt; false files answered calls only.
# Default: true
# CRM_SYNC_UNANSWERED=true

# How often the sync process looks for new results, and how many it takes per
# pass.
# Default: 15 / 20
# CRM_SYNC_POLL_SECS=15
# CRM_SYNC_BATCH=20

# Retries after a transient failure (the CRM down, rate-limited, a timeout):
# the wait doubles from CRM_SYNC_RETRY_SECS up to CRM_SYNC_MAX_RETRY_SECS, for
# up to CRM_SYNC_MAX_ATTEMPTS passes, then the row is FAILED with the reason.
# A refusal on the merits is FAILED at once. A rejected token stops the pass
# rather than failing every row.
# Default: 8 attempts, 60 s doubling to 3600 s
# CRM_SYNC_MAX_ATTEMPTS=8
# CRM_SYNC_RETRY_SECS=60
# CRM_SYNC_MAX_RETRY_SECS=3600

# A row claimed this long ago by a sync process that never reported back (it
# was killed mid-pass) is claimed again.
# Default: 900
# CRM_SYNC_STALE_SECS=900


# ============================================================================
# REAL BOOKINGS AND REAL TRANSFERS (Phase 16) — what a live test needs
# ============================================================================
# Both features are exercised against stubs by the check scripts, and neither
# has been seen live from this machine. To try them for real:
#
# A meeting booked into a real Cal.com calendar:
#   CALENDAR_PROVIDER=calcom
#   CALCOM_API_KEY=cal_live_...        Cal.com → Settings → Developer → API keys
#   CALCOM_EVENT_TYPE_ID=123456        the number in the event type's URL
#   CALENDAR_SLOT_MINUTES=30           must match the event type's length
#   CALENDAR_TIMEZONE=Asia/Karachi     the zone the meeting is stated in
#   uv run health.py calendar          reads the event type back: the key works,
#                                      the id exists, the length matches
#   Then a call — real, or `tests/fake_carrier.py --say` — that reaches the
#   meeting stage and gives an email (Cal.com needs one). The booking appears
#   in Cal.com and in `uv run campaign.py meetings` with its Cal.com uid.
#   Cal.com enforces its own availability: a slot taken between the offer and
#   the booking is refused and the agent offers another time.
#
# A live call handed to a person:
#   TELEPHONY_TRANSFER_NUMBER=+92...   a phone you can answer
#   TELEPHONY_PUBLIC_URL=https://...   so the carrier can report the outcome
#   (SIGNALWIRE_SIGNING_KEY too, on SignalWire — see the webhooks section)
#   uv run bot.py; uv run call.py <your other phone>; ask for a person.
#   The bot's line closes when the carrier moves the call; the transfer phone
#   rings; `uv run campaign.py transfers` shows REQUESTED, then ANSWERED /
#   NO_ANSWER / BUSY / FAILED with the duration once the leg has ended. If
#   nobody answers within TELEPHONY_TRANSFER_TIMEOUT_SECS the prospect hears
#   the carrier say nobody is available.


# ============================================================================
# AUTOMATION — n8n (Phase 17)
# ============================================================================
# An automation platform sits OUTSIDE the call. n8n never touches STT, the
# model, TTS, VAD or turn detection; it talks to two things that run in a
# process of their own, `uv run automation.py`:
#
#   CSV / CRM / event
#       ↓
#   n8n  --HTTP + API key-->  the automation API   (prospects, campaigns, calls,
#                                                   callbacks, results)
#                                     ↓ rows
#                             the scheduler         `uv run campaign.py run` places
#                                                   the call, under every calling rule
#                                     ↓
#                             the bot               holds the conversation, unaware
#                                     ↓ rows
#   n8n  <--signed POST-----  the outbox            call.completed, lead.qualified,
#                                                   meeting.booked, callback.scheduled,
#                                                   call.updated, campaign.completed
#       ↓
#   CRM / calendar / notifications
#
# The API never dials: `POST /api/v1/calls` writes the same pending-callback
# row the agent writes when a prospect asks to be phoned back, and the worker
# places it on its next tick. Every write is idempotent (natural keys, plus an
# `Idempotency-Key` header whose answer is replayed). Every event is delivered
# once per row, with the same `event_id` on every redelivery.
#
#   uv run automation.py                 # API on 127.0.0.1:7890 + the deliverer
#   uv run automation.py --once          # one delivery pass, for cron
#   uv run campaign.py events            # the outbox: sent, retrying, failed
#   uv run campaign.py events-retry --all-failed
#
# The endpoints, the payloads and six importable n8n workflows are documented
# in n8n/README.md at the repository root.

# ---- The API ----------------------------------------------------------------

# REQUIRED for the API to serve. One or more keys, comma-separated, each at
# least 16 characters; every request carries one as
# `Authorization: Bearer <key>` (or `X-API-Key: <key>`). Several keys let you
# rotate: add the new one, move n8n's credential, remove the old. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit it. Scrubbed from every log line.
# AUTOMATION_API_KEYS=

# Where the API binds. Loopback by default; n8n on another machine needs
# 0.0.0.0 behind TLS (a reverse proxy, a tunnel) — the key travels in clear
# over plain HTTP.
# AUTOMATION_HOST=127.0.0.1
# AUTOMATION_PORT=7890

# How long a stored `Idempotency-Key` answer is replayed.
# Default: 86400 (a day)
# AUTOMATION_IDEMPOTENCY_TTL_SECS=86400

# ---- The events -------------------------------------------------------------

# Where events are POSTed: n8n's Webhook node URL (Production URL, not the
# Test URL — the test one only listens while you click "Listen"). Unset =
# nothing is delivered. Every enabled kind goes here unless a per-kind URL
# below names another address.
# AUTOMATION_WEBHOOK_URL=https://n8n.example.com/webhook/aiva-events

# Per-kind targets, when one workflow per event is easier than a Switch node.
# AUTOMATION_WEBHOOK_URL_CALL_COMPLETED=https://n8n.example.com/webhook/aiva-call-completed
# AUTOMATION_WEBHOOK_URL_LEAD_QUALIFIED=https://n8n.example.com/webhook/aiva-lead-qualified
# AUTOMATION_WEBHOOK_URL_MEETING_BOOKED=https://n8n.example.com/webhook/aiva-meeting-booked
# AUTOMATION_WEBHOOK_URL_CALLBACK_SCHEDULED=
# AUTOMATION_WEBHOOK_URL_CALL_UPDATED=
# AUTOMATION_WEBHOOK_URL_CAMPAIGN_COMPLETED=

# Which kinds to create and deliver. Default: all of them.
#   call.completed      a finished call's result, once it has settled
#   call.updated        the result changed after call.completed was delivered
#   lead.qualified      a result whose qualification_status is QUALIFIED
#   meeting.booked      a meeting the calendar confirmed
#   callback.scheduled  a callback promised (by the agent, or through the API)
#   campaign.completed  the scheduler closed a campaign
# AUTOMATION_EVENTS=call.completed,lead.qualified,meeting.booked

# Signs every delivery: `X-Aiva-Signature: t=<unix>,v1=<hex>`, an HMAC-SHA256
# over "<t>." + the raw body. Optional but recommended; n8n/README.md has the
# receiver's check. Never commit it.
# AUTOMATION_WEBHOOK_SECRET=

# A static header on every delivery, for n8n's Webhook node "Header Auth"
# credential — the check n8n does natively. The header name defaults to
# X-Aiva-Key when only the token is set.
# AUTOMATION_WEBHOOK_AUTH_HEADER=X-Aiva-Key
# AUTOMATION_WEBHOOK_AUTH_TOKEN=

# Only facts recorded at or after this moment become events. Unset on a
# database with history means the first run tells n8n about every result ever
# written — set this before the first run if that is not wanted.
# AUTOMATION_EVENTS_SINCE=2026-09-07T00:00:00Z

# How long a call result must have been unchanged before its events are
# created. The carrier's thin result and the conversation's rich one land
# seconds apart; this is what makes call.completed carry the rich one.
# Default: 30
# AUTOMATION_SETTLE_SECS=30

# Whether call.* payloads carry the transcript. Off by default: it is the
# largest thing in a result; GET /api/v1/results/{id} has it on demand.
# AUTOMATION_INCLUDE_TRANSCRIPT=false

# How often the deliverer looks, and how many events it takes per pass.
# Default: 10 / 20
# AUTOMATION_POLL_SECS=10
# AUTOMATION_BATCH=20

# Retries after a transient failure (a timeout, a refused connection,
# 408/425/429/5xx, or 404 — n8n answers 404 for a workflow that is not
# active yet): the wait doubles from AUTOMATION_RETRY_SECS up to
# AUTOMATION_MAX_RETRY_SECS, honouring Retry-After, for up to
# AUTOMATION_MAX_ATTEMPTS passes, then the event is FAILED with the reason.
# Any other 4xx is FAILED at once. `campaign.py events-retry` reopens.
# Default: 12 attempts, 30 s doubling to 1800 s, 15 s per request
# AUTOMATION_MAX_ATTEMPTS=12
# AUTOMATION_RETRY_SECS=30
# AUTOMATION_MAX_RETRY_SECS=1800
# AUTOMATION_TIMEOUT_SECS=15

# An event claimed this long ago by a deliverer that never reported back is
# claimed again.
# Default: 600
# AUTOMATION_STALE_SECS=600

# ============================================================================
# SECURITY — authentication, authorisation, hardening (Phase 18)
# ============================================================================
# Read by dashboard.py, automation.py and webhooks.py; never by the bot.
# `uv run security.py check` reports the posture; SECURITY.md is the reference.

# ---- The dashboard login ---------------------------------------------------
# Users as name:role:hash, comma-separated. Roles: admin, operator, viewer.
# Make a hash with `uv run security.py hash-password` — NEVER a plain password.
# DASHBOARD_USERS=alice:admin:scrypt$16384$8$1$...$...,sam:viewer:scrypt$...

# Signs the session cookie. Unset: generated at boot (sessions end at every
# restart, and two dashboard processes do not share them).
# `uv run security.py make-secret`. Never commit it. Scrubbed from every log line.
# DASHBOARD_SESSION_SECRET=

# How long a login lasts. Default: 43200 (12 h)
# DASHBOARD_SESSION_TTL_SECS=43200

# Serve the dashboard with no login, as Phase 10 did — loopback only.
# Default: false
# DASHBOARD_AUTH_DISABLED=false

# ---- Sign-up on the application (Phase 27) --------------------------------
# The application's login has a "Create one" link to a Register page (name,
# email, role, password, confirm). A sign-up becomes a row of the
# dashboard_users table (`uv run campaign.py init` adds it; the hash is the
# same scrypt as DASHBOARD_USERS) and signs in through the same login, by
# name or email. A Viewer is active at once. An Operator or Admin request is
# `pending` and cannot sign in until an admin approves it on the Settings
# page (Sign-up requests) — the role sent by the browser never grants
# anything by itself. DASHBOARD_USERS entries are untouched and always win.
# Default: true. Set false to close the page on a deployment where accounts
# are handed out by hand.
# DASHBOARD_REGISTRATION_ENABLED=true

# ---- Role-scoped API keys ----------------------------------------------------
# AUTOMATION_API_KEYS (above) are admin keys. Operator keys read the people
# and make phones ring but cannot close a campaign, retry the outbox or read
# the audit log; viewer keys read totals and outcomes with numbers masked.
# `uv run security.py make-key --role operator`
# AUTOMATION_OPERATOR_API_KEYS=
# AUTOMATION_VIEWER_API_KEYS=

# Serve /api/v1/docs and the OpenAPI schema. Default: true
# AUTOMATION_DOCS_ENABLED=true

# ---- Transport -------------------------------------------------------------------
# Refuse plain HTTP (dashboard pages redirected, API calls 403), send HSTS,
# mark the cookie Secure. REQUIRED in production, behind a TLS proxy.
# Default: false
# SECURITY_REQUIRE_HTTPS=false

# Networks whose X-Forwarded-Proto / X-Forwarded-For are believed. CIDRs,
# comma-separated. Default: loopback (a proxy or tunnel on this machine).
# SECURITY_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Origins a browser may call from. Explicit only; a wildcard is refused.
# Unset: no cross-origin access at all.
# SECURITY_CORS_ORIGINS=https://app.example.com

# ---- Limits ---------------------------------------------------------------------
# Requests per minute: per API key; per address with no valid credential;
# login attempts per address. 0 disables one.
# Default: 300 / 30 / 5
# SECURITY_API_RATE_LIMIT=300
# SECURITY_ANON_RATE_LIMIT=30
# SECURITY_LOGIN_RATE_LIMIT=5

# The largest request body accepted, in bytes. Default: 5242880 (5 MiB)
# SECURITY_MAX_BODY_BYTES=5242880

# ---- The audit log --------------------------------------------------------------
# Every login, key refusal, write and transcript read as an audit_log row
# (`uv run campaign.py init` adds the table; `uv run campaign.py audit` reads it).
# strict: refuse the action when the row cannot be written, instead of logging.
# Default: true / false
# SECURITY_AUDIT_ENABLED=true
# SECURITY_AUDIT_STRICT=false

# ============================================================================
# COMPLIANCE — outbound calling controls (Phase 19)
# ============================================================================
# Policies the operator configures; the software applies them and records
# that it did. Nothing here encodes what any law requires — COMPLIANCE.md
# lists which controls exist and which decisions are yours. The calling
# window (CALLING_*) and the attempt ceiling and retry wait (CAMPAIGN_*)
# above are the base; a campaign's `compliance` settings and the number's
# jurisdiction (below) overlay them. Do-not-call is always honoured.

# ---- Disclosures --------------------------------------------------------------
# What the agent says about being an AI, and whether its FIRST sentence must
# include it (it always answers honestly when asked, under every setting).
# Default: "I'm an AI assistant" / false
# COMPLIANCE_AI_DISCLOSURE=I'm an AI assistant
# COMPLIANCE_AI_DISCLOSURE_REQUIRED=false

# Whether your carrier or proxy records calls (this software does not), the
# sentence to open with when it does, and whether it is required.
# Default: false / "this call may be recorded" / same as _ENABLED
# COMPLIANCE_RECORDING_ENABLED=false
# COMPLIANCE_RECORDING_DISCLOSURE=this call may be recorded
# COMPLIANCE_RECORDING_DISCLOSURE_REQUIRED=false

# ---- Retry delays per outcome (minutes) ------------------------------------------
# Override CAMPAIGN_RETRY_MINUTES for one outcome. FAILED is never retried.
# COMPLIANCE_RETRY_MINUTES_NO_ANSWER=60
# COMPLIANCE_RETRY_MINUTES_BUSY=15
# COMPLIANCE_RETRY_MINUTES_VOICEMAIL=240

# ---- Jurisdictions -----------------------------------------------------------------
# A JSON object: region code (the number's country, e.g. US, GB, PK) -> any of
# the campaign compliance keys: calling_hours, calling_days, timezone,
# enforce_calling_hours, max_attempts, retry_minutes, retry_minutes_no_answer,
# retry_minutes_busy, retry_minutes_voicemail, ai_disclosure,
# ai_disclosure_required, recording_enabled, recording_disclosure,
# recording_disclosure_required, jurisdiction. Applied AFTER a campaign's
# settings, so a campaign cannot loosen a country's rule. Validated at startup.
# The example is an illustration of the shape, not a statement of any law.
# COMPLIANCE_JURISDICTIONS={"US": {"calling_hours": "08:00-21:00", "calling_days": "mon-sun", "max_attempts": 3, "ai_disclosure_required": true}}

# A label for numbers whose region is unknown. Default: unset
# COMPLIANCE_DEFAULT_JURISDICTION=

# Write an audit row for every call the gate ALLOWED, not only refusals.
# Default: true
# COMPLIANCE_AUDIT_ALLOWED=true


# ============================================================================
# MONITORING — health, readiness, metrics, correlation ids (Phase 22)
# ============================================================================
# Every server this project runs — the bot's runner (7860), the dashboard
# (7870), the webhook receiver (7880), the automation API (7890) — answers
# three routes: GET /healthz (liveness: the process runs), GET /readyz
# (readiness: the database answers and the process is not stopping; 503
# otherwise) and GET /metrics (Prometheus text; /metrics.json with exact
# percentiles). The scheduler (`campaign.py run`) has no server of its own,
# so it opens one on MONITORING_PORT. Nothing here changes what a call does.
#
# Every log line about a call carries `trace=<16 hex>` — born at the dialer,
# on the attempt row (`campaign.py init` adds the column), on the carrier's
# handshake, read back by the receiver, the CRM syncer and the deliverer —
# and every JSON line carries `component` (bot, scheduler, dashboard, api,
# webhooks) and `pid`. `uv run campaign.py metrics` prints the fleet's
# figures from the rows; `--prometheus` for a textfile collector.

# Serve the routes at all. Off leaves every process as it was before.
# Default: true
# MONITORING_ENABLED=true

# Where `campaign.py run` serves its own three routes. Port 0 turns that
# server off; a second worker on the same machine finds the port taken,
# logs one line and keeps dialling.
# Default: 127.0.0.1 / 7895
# MONITORING_HOST=127.0.0.1
# MONITORING_PORT=7895

# A bearer token /metrics and /metrics.json demand (at least 16 characters).
# The numbers name campaign ids, error rates and costs, never people; leave
# it unset on a loopback deployment, set it once a port is reachable from a
# network. /healthz and /readyz stay open: a probe holds no key.
# Default: unset (open)
# MONITORING_TOKEN=

# How often a server re-reads queue depth, worker health and throughput from
# PostgreSQL into its gauges, and the window aiva_throughput_calls counts.
# Default: 30 / 3600
# MONITORING_REFRESH_SECS=30
# MONITORING_THROUGHPUT_WINDOW_SECS=3600

# Name the process on every JSON log line (each entry point sets its own;
# this overrides it for a custom launcher). Default: per entry point
# LOG_COMPONENT=


# ============================================================================
# THE APPLICATION — one address for every page (Phase 24)
# ============================================================================
# `uv run app.py` serves the browser application at http://127.0.0.1:7900/app/
# over the existing dashboard (mounted at /dashboard) and automation API
# (mounted at /automation), with the dashboard's login driving every page.
# Sign in with a DASHBOARD_USERS account. Nothing here changes what a call
# does; `--with-scheduler` starts `campaign.py run` as a child process so one
# command also dials every ACTIVE campaign.

# Where to bind. Default: 127.0.0.1 / 7900
# APP_HOST=127.0.0.1
# APP_PORT=7900

# Where the bot's browser client is served, for the Live AI Agent page.
# Default: http://127.0.0.1:7860
# APP_BOT_URL=http://127.0.0.1:7860

# Phase 34 — one public hostname for the application and the bot.
# A free ngrok tunnel gives one hostname pointing at one local port, and the
# carrier needs the bot's `/ws` and `POST /` on that hostname. With this on,
# app.py forwards every path it does not own (/client, /api/offer, /ws,
# POST /, ...) to APP_BOT_URL, so `ngrok http 7900` serves both: the
# application at /app/ and the bot's client at /client/ (the Live Agent page
# frames it from this same origin). Keep TELEPHONY_PUBLIC_URL as the tunnel's
# https URL. Off: the tunnel must point at the bot (ngrok http 7860) and the
# application stays local. Also `app.py --proxy-bot`.
# APP_PROXY_BOT=false

# Phase 35 — the live event stream (/api/app/stream, server-sent events that
# the dashboard and campaign pages subscribe to). Off where a long-lived
# response is unwelcome (the Vercel deployment sets this itself): the route
# answers 204 and the page polls every 15 s instead. Default: true
# APP_STREAM_ENABLED=true

# Phase 25 — the campaign execution engine inside app.py
# WORKER_EMBEDDED=true          # run the scheduler inside `app.py` (false: only `campaign.py run` dials)
# WORKER_SHUTDOWN_SECS=30       # on shutdown, how long calls in progress get before they are handed over
